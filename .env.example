# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Domínio principal da plataforma. Cada loja vira <loja>.<domínio>.
# Deixe vazio enquanto não tiver domínio: as lojas ficam em /loja/<endereco>.
NEXT_PUBLIC_ROOT_DOMAIN=

# Leitura do cardápio por foto (Claude, da Anthropic). Só no servidor: nunca use NEXT_PUBLIC_.
# Crie em https://console.anthropic.com > API Keys. Sem a chave, o resto do sistema funciona normalmente.
ANTHROPIC_API_KEY=
